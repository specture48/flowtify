{
  "name": "flowtify-workspace",
  "version": "1.0.13",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace flowtify build",
    "build:all": "yarn workspaces foreach --all run build",
    "clean": "yarn workspaces foreach --all run clean",
    "test": "yarn workspace flowtify test",
    "example:order-processing": "cd packages/nestjs-flowtify/examples && yarn start"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
